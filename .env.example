# Copy to .env (never commit .env). Only GROQ_API_KEY is required for the open profile.
GROQ_API_KEY=
GIGBID_PROFILE=open            # open | local | paid | stub(tests only)
GIGBID_SECRET=change-me-to-a-long-random-string
REVIEWER_EMAIL=reviewer@gigbid.local
REVIEWER_PASSWORD=change-me
GIGSIM_ADMIN_KEY=gigsim-admin
# optional
OPENROUTER_API_KEY=
OLLAMA_SMALL=qwen3:4b
OLLAMA_STRONG=qwen3:4b
GIGBID_PROMPT_GUARD=false
MARKETPLACE_MODE=gigsim        # gigsim | upwork_live
