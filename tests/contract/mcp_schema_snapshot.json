  "create_proposal_draft": {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true,
    "readOnlyHint": false
   },
   "input": {
    "properties": {
     "bid_amount": {
      "exclusiveMinimum": 0,
      "maximum": 100000,
      "title": "Bid Amount",
      "type": "number"
     },
     "bid_type": {
      "default": "fixed",
      "enum": [
       "fixed",
       "hourly"
      ],
      "title": "Bid Type",
      "type": "string"
     },
     "cover_letter": {
      "maxLength": 5000,
      "minLength": 200,
      "title": "Cover Letter",
      "type": "string"
     },
     "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "client-generated key; repeating a call with the same key never acts twice",
      "maxLength": 128,
      "minLength": 16,
      "pattern": "^[A-Za-z0-9:_\\-]+$",
      "title": "Idempotency Key",
      "type": "string"
     },
     "job_id": {
      "maxLength": 80,
      "minLength": 3,
      "title": "Job Id",
      "type": "string"
     },
     "screening_answers": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "title": "Screening Answers",
      "type": "array"
     }
    },
    "required": [
     "job_id",
     "cover_letter",
     "bid_amount",
     "idempotency_key"
    ],
    "title": "create_proposal_draftArguments",
    "type": "object"
   },
   "output": {
    "properties": {
     "balance_after": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Balance After"
     },
     "connects_cost": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Connects Cost"
     },
     "connects_spent": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Connects Spent"
     },
     "dry_run": {
      "title": "Dry Run",
      "type": "boolean"
     },
     "message_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Message Id"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Note"
     },
     "policy_violations": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Policy Violations",
      "type": "array"
     },
     "proposal_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Proposal Id"
     },
     "replay": {
      "default": false,
      "title": "Replay",
      "type": "boolean"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "would_be_accepted": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Would Be Accepted"
     },
